[
  {"id": "wordpress", "name": "WordPress", "category": "cms",
   "rules": [{"type": "body", "regex": "/wp-content/|/wp-includes/"}, {"type": "meta_generator", "regex": "WordPress"}, {"type": "cookie", "name_regex": "^wordpress_|^wp-settings"}],
   "version": {"source": "meta_generator", "regex": "WordPress ([\\d.]+)"}},
  {"id": "joomla", "name": "Joomla", "category": "cms",
   "rules": [{"type": "meta_generator", "regex": "Joomla"}, {"type": "body", "regex": "/media/jui/|/components/com_"}],
   "version": {"source": "meta_generator", "regex": "Joomla! ([\\d.]+)"}},
  {"id": "drupal", "name": "Drupal", "category": "cms",
   "rules": [{"type": "header", "name": "X-Generator", "regex": "Drupal"}, {"type": "meta_generator", "regex": "Drupal"}, {"type": "header", "name": "X-Drupal-Cache"}, {"type": "body", "regex": "/sites/default/files/"}],
   "version": {"source": "meta_generator", "regex": "Drupal (\\d+)"}},
  {"id": "typo3", "name": "TYPO3", "category": "cms",
   "rules": [{"type": "meta_generator", "regex": "TYPO3"}, {"type": "body", "regex": "/typo3conf/|/typo3temp/"}]},
  {"id": "moodle", "name": "Moodle", "category": "cms",
   "rules": [{"type": "cookie", "name_regex": "^MoodleSession"}, {"type": "body", "regex": "moodle-[a-z]|M\\.cfg\\s*="}]},

  {"id": "nginx", "name": "nginx", "category": "server",
   "rules": [{"type": "header", "name": "Server", "regex": "nginx"}],
   "version": {"source": "header:server", "regex": "nginx/([\\d.]+)"}},
  {"id": "apache-httpd", "name": "Apache httpd", "category": "server",
   "rules": [{"type": "header", "name": "Server", "regex": "^Apache"}],
   "version": {"source": "header:server", "regex": "Apache/([\\d.]+)"}},
  {"id": "iis", "name": "Microsoft IIS", "category": "server",
   "rules": [{"type": "header", "name": "Server", "regex": "Microsoft-IIS"}],
   "version": {"source": "header:server", "regex": "IIS/([\\d.]+)"}},
  {"id": "tomcat", "name": "Apache Tomcat", "category": "server",
   "rules": [{"type": "title", "regex": "Apache Tomcat"}, {"type": "body", "regex": "Apache Tomcat/\\d"}],
   "version": {"source": "body", "regex": "Apache Tomcat/([\\d.]+)"}},
  {"id": "php", "name": "PHP", "category": "framework",
   "rules": [{"type": "header", "name": "X-Powered-By", "regex": "PHP"}, {"type": "cookie", "name_regex": "^PHPSESSID$"}],
   "version": {"source": "header:x-powered-by", "regex": "PHP/([\\d.]+)"}},
  {"id": "aspnet", "name": "ASP.NET", "category": "framework",
   "rules": [{"type": "header", "name": "X-AspNet-Version"}, {"type": "header", "name": "X-Powered-By", "regex": "ASP\\.NET"}, {"type": "cookie", "name_regex": "^ASP\\.NET_SessionId$"}]},
  {"id": "django", "name": "Django", "category": "framework",
   "rules": [{"type": "cookie", "name_regex": "^csrftoken$"}, {"type": "body", "regex": "csrfmiddlewaretoken"}]},
  {"id": "laravel", "name": "Laravel", "category": "framework",
   "rules": [{"type": "cookie", "name_regex": "^laravel_session$|^XSRF-TOKEN$"}]},
  {"id": "express", "name": "Express (Node.js)", "category": "framework",
   "rules": [{"type": "header", "name": "X-Powered-By", "regex": "Express"}]},
  {"id": "spring-boot", "name": "Spring Boot Actuator", "category": "framework", "severity": "low", "path": "/actuator/health",
   "rules": [{"type": "body", "regex": "\"status\"\\s*:\\s*\"(UP|DOWN)\""}]},

  {"id": "jenkins", "name": "Jenkins", "category": "devops", "severity": "low",
   "rules": [{"type": "header", "name": "X-Jenkins"}, {"type": "title", "regex": "Jenkins"}],
   "version": {"source": "header:x-jenkins", "regex": "([\\d.]+)"}},
  {"id": "gitlab", "name": "GitLab", "category": "devops",
   "rules": [{"type": "cookie", "name_regex": "^_gitlab_session$"}, {"type": "title", "regex": "GitLab"}]},
  {"id": "grafana", "name": "Grafana", "category": "devops",
   "rules": [{"type": "title", "regex": "Grafana"}, {"type": "cookie", "name_regex": "^grafana_session"}, {"type": "body", "regex": "grafana-app"}]},
  {"id": "kibana", "name": "Kibana", "category": "devops",
   "rules": [{"type": "header", "name": "kbn-name"}, {"type": "title", "regex": "Kibana|Elastic"}]},
  {"id": "prometheus", "name": "Prometheus", "category": "devops", "severity": "low",
   "rules": [{"type": "title", "regex": "Prometheus Time Series"}]},
  {"id": "elasticsearch", "name": "Elasticsearch", "category": "database", "severity": "low",
   "rules": [{"type": "body", "regex": "\"cluster_name\"\\s*:"}, {"type": "body", "regex": "You Know, for Search"}], "match": "any",
   "version": {"source": "body", "regex": "\"number\"\\s*:\\s*\"([\\d.]+)\""}},
  {"id": "rabbitmq", "name": "RabbitMQ Management", "category": "devops",
   "rules": [{"type": "title", "regex": "RabbitMQ Management"}]},
  {"id": "swagger", "name": "Swagger UI / OpenAPI", "category": "devops", "severity": "low", "path": "/swagger-ui/index.html",
   "rules": [{"type": "body", "regex": "swagger-ui"}]},

  {"id": "phpmyadmin", "name": "phpMyAdmin", "category": "admin_panel", "severity": "low", "path": "/phpmyadmin/",
   "rules": [{"type": "title", "regex": "phpMyAdmin"}, {"type": "body", "regex": "pma_username|phpMyAdmin"}]},
  {"id": "wp-admin", "name": "WordPress login", "category": "admin_panel", "path": "/wp-login.php",
   "rules": [{"type": "body", "regex": "user_login|wp-submit"}]},
  {"id": "tomcat-manager", "name": "Tomcat Manager", "category": "admin_panel", "severity": "low", "path": "/manager/html",
   "rules": [{"type": "header", "name": "WWW-Authenticate", "regex": "Tomcat Manager"}, {"type": "body", "regex": "Tomcat Web Application Manager"}]},
  {"id": "path-admin", "name": "Sciezka /admin", "category": "admin_panel", "path": "/admin",
   "rules": [{"type": "body", "regex": "<form[^>]*>|password|login|admin"}]},
  {"id": "path-login", "name": "Sciezka /login", "category": "admin_panel", "path": "/login",
   "rules": [{"type": "body", "regex": "type=[\"']password[\"']"}]},
  {"id": "path-version", "name": "Ujawniona wersja (/version)", "category": "other", "severity": "low", "path": "/version",
   "rules": [{"type": "body", "regex": "\"?version\"?\\s*[:=]\\s*\"?v?\\d+\\.\\d+"}],
   "version": {"source": "body", "regex": "version\"?\\s*[:=]\\s*\"?v?([\\d.]+)"}},
  {"id": "footer-version", "name": "Wersja w stopce", "category": "other",
   "rules": [{"type": "body", "regex": "(?:powered by|version|wersja)\\s*[: ]\\s*v?\\d+\\.\\d+(?:\\.\\d+)?"}],
   "version": {"source": "body", "regex": "(?:powered by|version|wersja)[^<\\d]{0,20}v?(\\d+\\.\\d+(?:\\.\\d+)?)"}},
  {"id": "staging-header", "name": "Naglowek srodowiska testowego", "category": "staging",
   "rules": [{"type": "header", "name": "X-Environment", "regex": "dev|test|stag|uat|qa"}, {"type": "header", "name": "X-Debug-Token"}]},

  {"id": "mikrotik", "name": "MikroTik RouterOS", "category": "iot",
   "rules": [{"type": "title", "regex": "RouterOS|MikroTik"}, {"type": "body", "regex": "mikrotik"}]},
  {"id": "hikvision", "name": "Hikvision (kamera IP)", "category": "iot",
   "rules": [{"type": "body", "regex": "doc/page/login\\.asp|Hikvision"}, {"type": "header", "name": "Server", "regex": "Hikvision|DNVRS-Webs|App-webs"}]},
  {"id": "unifi", "name": "Ubiquiti UniFi", "category": "iot",
   "rules": [{"type": "title", "regex": "UniFi"}]},
  {"id": "printer", "name": "Drukarka sieciowa", "category": "iot",
   "rules": [{"type": "title", "regex": "HP LaserJet|HP Color LaserJet|Brother|Kyocera|RICOH|Xerox|EpsonNet|Lexmark"}, {"type": "header", "name": "Server", "regex": "HP HTTP Server|Virata-EmWeb|KM-MFP"}]},
  {"id": "synology", "name": "Synology DSM", "category": "iot",
   "rules": [{"type": "title", "regex": "Synology|DiskStation"}]},
  {"id": "esp-iot", "name": "ESP8266/ESP32 (IoT)", "category": "iot",
   "rules": [{"type": "header", "name": "Server", "regex": "ESP|arduino"}, {"type": "title", "regex": "Tasmota|ESPHome|WLED|Shelly"}]}
]
